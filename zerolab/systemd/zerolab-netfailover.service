[Unit]
Description=ZeroLab Wi-Fi to Bluetooth failover controller
Wants=NetworkManager.service bluetooth.service
After=NetworkManager.service bluetooth.service

[Service]
Type=simple
ExecStart=/usr/local/lib/zerolab/netfailover.py
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
