#!/bin/bash
set -eu -o pipefail

source /usr/local/lib/zerolab/common.sh

G="$ZEROLAB_GADGET"
UDC="$(zerolab_udc)"

cleanup_on_error()
{
    rc=$?

    if [ "$rc" -ne 0 ]; then
        echo "ZeroLab HID setup failed; cleaning partial gadget" >&2

        /usr/local/lib/zerolab/profiles/down \
            >/dev/null 2>&1 || true
    fi

    exit "$rc"
}

trap cleanup_on_error EXIT

zerolab_require_usb_identity
zerolab_require_clean
test -n "$UDC"

modprobe libcomposite

mkdir "$G"

zerolab_apply_usb_identity "$G"
echo 0x0100 > "$G/bcdDevice"
echo 0x0200 > "$G/bcdUSB"

mkdir -p "$G/strings/0x409"

echo ZEROLAB0001 \
    > "$G/strings/0x409/serialnumber"

echo ZeroLab \
    > "$G/strings/0x409/manufacturer"

echo 'ZeroLab HID Keyboard' \
    > "$G/strings/0x409/product"

mkdir -p "$G/configs/c.1/strings/0x409"

echo 'ZeroLab Keyboard' \
    > "$G/configs/c.1/strings/0x409/configuration"

echo 120 \
    > "$G/configs/c.1/MaxPower"

mkdir "$G/functions/hid.usb0"

echo 1 \
    > "$G/functions/hid.usb0/protocol"

echo 1 \
    > "$G/functions/hid.usb0/subclass"

echo 8 \
    > "$G/functions/hid.usb0/report_length"

python3 - <<'PY' > /tmp/zerolab-hid-report-desc
import sys

desc = bytes([
    0x05, 0x01,
    0x09, 0x06,
    0xA1, 0x01,
    0x05, 0x07,

    0x19, 0xE0,
    0x29, 0xE7,
    0x15, 0x00,
    0x25, 0x01,
    0x75, 0x01,
    0x95, 0x08,
    0x81, 0x02,

    0x95, 0x01,
    0x75, 0x08,
    0x81, 0x01,

    0x95, 0x05,
    0x75, 0x01,
    0x05, 0x08,
    0x19, 0x01,
    0x29, 0x05,
    0x91, 0x02,

    0x95, 0x01,
    0x75, 0x03,
    0x91, 0x01,

    0x95, 0x06,
    0x75, 0x08,
    0x15, 0x00,
    0x25, 0x65,
    0x05, 0x07,
    0x19, 0x00,
    0x29, 0x65,
    0x81, 0x00,

    0xC0,
])

sys.stdout.buffer.write(desc)
PY

cat /tmp/zerolab-hid-report-desc \
    > "$G/functions/hid.usb0/report_desc"

rm -f /tmp/zerolab-hid-report-desc

ln -s \
    "$G/functions/hid.usb0" \
    "$G/configs/c.1/hid.usb0"

echo "$UDC" > "$G/UDC"

echo 'Waiting for hidg0...'

for _ in $(seq 1 40); do
    [ -e /dev/hidg0 ] && break
    sleep 0.25
done

test -e /dev/hidg0

# Do not transmit reports during profile activation.
# /dev/hidg0 can exist before the USB host has completed enumeration,
# and report delivery belongs to the HID engine rather than gadget setup.

trap - EXIT

printf 'ZeroLab HID active: UDC=%s state=%s\n' \
    "$UDC" \
    "$(cat "/sys/class/udc/$UDC/state")"

ls -l /dev/hidg0

printf 'Power: '
vcgencmd get_throttled
